            <artifactId>codegen-python</artifactId>
        </dependency>
        <dependency>
            <groupId>net.postchain.rell</groupId>
            <artifactId>codegen</artifactId>
        </dependency>
        <dependency>
            <groupId>net.postchain</groupId>
            <artifactId>postchain-eif-core</artifactId>
            <version>${eif.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chromia.rell.dokka</groupId>
            <artifactId>rell-dokka-plugin</artifactId>
            <version>${rell.dokka.version}</version>
        </dependency>
        <dependency>
            <groupId>net.postchain.rell.toolbox</groupId>
            <artifactId>code-quality</artifactId>
        </dependency>
        <dependency>
            <groupId>net.postchain.rell.toolbox</groupId>
            <artifactId>seeder</artifactId>
        </dependency>
        <dependency>
            <groupId>net.postchain.rell.toolbox</groupId>
            <artifactId>indexer</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.chromia.cli</groupId>
                    <artifactId>chromia-build-tools</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>net.postchain.rell.toolbox</groupId>
