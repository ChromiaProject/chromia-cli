<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>chromia-cli-parent</artifactId>
    <groupId>com.chromia.cli</groupId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <modules>
        <module>chromia-cli</module>
        <module>chromia-cli-tools</module>
        <module>chromia-build-tools</module>
        <module>coverage-report-aggregate</module>
    </modules>

    <name>Chromia Cli Parent</name>

    <properties>
        <revision>dev</revision>
        <codegen.version>0.13.0</codegen.version>
        <postchain.version>3.14.2</postchain.version>
        <postchain.chromia.version>3.14.0</postchain.chromia.version>
        <postchain.client.version>3.11.6</postchain.client.version>
        <rell.version>0.13.5</rell.version>
        <eif.version>0.2.10</eif.version>
        <directory.chain.version>1.28.0</directory.chain.version>
        <directory.source>${project.build.directory}/directory-chain/src</directory.source>

        <jgit.version>6.7.0.202309050840-r</jgit.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.version>1.8.21</kotlin.version>
        <kotlin.compiler.jvmTarget>17</kotlin.compiler.jvmTarget>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <kotlin.code.style>obsolete</kotlin.code.style>
        <project.build.outputTimestamp>10</project.build.outputTimestamp>

        <assembly.path>${project.basedir}/src/main/assembly/targz.xml</assembly.path>
        <image.platforms>linux/amd64,linux/arm64</image.platforms>
        <gitlab.registry>registry.gitlab.com/chromaway/core-tools/chromia-cli</gitlab.registry>
    </properties>

    <repositories>
        <repository>
            <id>chromia-parent</id>
            <name>Chromia parent GitLab Registry</name>
            <url>https://gitlab.com/api/v4/projects/50818999/packages/maven</url>
        </repository>
        <repository>
            <id>postchain-chromia</id>
            <url>https://gitlab.com/api/v4/projects/33481005/packages/maven</url>
        </repository>
        <repository>
            <id>postchain</id>
            <name>Postchain GitLab Registry</name>
            <url>https://gitlab.com/api/v4/projects/32294340/packages/maven</url>
        </repository>
        <repository>
            <id>postchain-client</id>
            <name>Postchain Client GitLab Registry</name>
            <url>https://gitlab.com/api/v4/projects/46288950/packages/maven</url>
        </repository>
        <repository>
            <id>rellr</id>
            <name>Rell Runtime Registry</name>
            <url>https://gitlab.com/api/v4/projects/32802097/packages/maven</url>
        </repository>
        <repository>
            <id>rell-codegen</id>
            <name>Rell Codegen Registry</name>
            <url>https://gitlab.com/api/v4/projects/37660703/packages/maven</url>
        </repository>
        <repository>
            <id>postchain-eif</id>
            <name>Postchain EIF Gtx module Registry</name>
            <url>https://gitlab.com/api/v4/projects/36768178/packages/maven</url>
        </repository>
        <repository>
            <id>mavenCentral</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>rell-maven</id>
            <url>https://gitlab.com/api/v4/projects/37668820/packages/maven</url>
        </pluginRepository>
    </pluginRepositories>
    <distributionManagement>
        <repository>
            <id>gitlab-maven</id>
            <url>https://gitlab.com/api/v4/projects/39844192/packages/maven</url>
        </repository>
    </distributionManagement>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.2.2</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>net.postchain.rell</groupId>
                    <artifactId>rell-maven-plugin</artifactId>
                    <version>0.7.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                            <configuration>
                                <sourceDirs>
                                    <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                                </sourceDirs>
                            </configuration>
                        </execution>
                        <execution>
                            <id>test-compile</id>
                            <phase>test-compile</phase>
                            <goals>
                                <goal>test-compile</goal>
                            </goals>
                            <configuration>
                                <sourceDirs>
                                    <sourceDir>${project.basedir}/src/test/kotlin</sourceDir>
                                </sourceDirs>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.10.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                    <configuration>
                        <workingDirectory>${project.build.directory}/test</workingDirectory>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                            <exclude>**/*SlowIntegrationTest.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.1.2</version>
                    <configuration>
                        <environmentVariables>
                            <DIST_EXECUTABLE>
                                ${project.build.directory}/${project.artifactId}-${project.version}-dist/bin/chr
                            </DIST_EXECUTABLE>
                            <PROJECT_VERSION>${project.version}</PROJECT_VERSION>
                        </environmentVariables>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>pl.project13.maven</groupId>
                    <artifactId>git-commit-id-plugin</artifactId>
                    <version>4.0.0</version>
                    <executions>
                        <execution>
                            <id>get-the-git-infos</id>
                            <goals>
                                <goal>revision</goal>
                            </goals>
                            <phase>initialize</phase>
                        </execution>
                    </executions>
                    <configuration>
                        <useNativeGit>true</useNativeGit> <!-- git worktree does not work with JGit implementation -->
                        <includeOnlyProperties>
                            <includeOnlyProperty>^git\.commit\.time$</includeOnlyProperty>
                        </includeOnlyProperties>
                        <dateFormatTimeZone>UTC</dateFormatTimeZone>
                        <dateFormat>yyyy-MM-dd'T'HH:mm:ssX</dateFormat>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>3.3.2</version>
                </plugin>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>8.4.0</version>
                    <configuration>
                        <prettyPrint>true</prettyPrint>
                        <failBuildOnAnyVulnerability>true</failBuildOnAnyVulnerability>
                        <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                        <yarnAuditAnalyzerEnabled>false</yarnAuditAnalyzerEnabled>
                        <suppressionFiles>
                            <suppressionFile>
                                https://gitlab.com/chromaway/chromia-parent/-/raw/dev/common-dependencies-suppression.xml?ref_type=heads
                            </suppressionFile>
                            <suppressionFile>dependencies-suppression.xml</suppressionFile>
                        </suppressionFiles>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.4.1</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-bom</artifactId>
                <version>${kotlin.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>net.postchain</groupId>
                <artifactId>postchain</artifactId>
                <version>${postchain.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.postchain.rell</groupId>
                <artifactId>rell</artifactId>
                <version>${rell.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.9.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.chromia.cli</groupId>
                <artifactId>chromia-cli-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.chromia.cli</groupId>
                <artifactId>chromia-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.chromia.cli</groupId>
                <artifactId>chromia-build-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.chromia.cli</groupId>
                <artifactId>chromia-build-tools</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>net.postchain.rell</groupId>
                <artifactId>rell-api-gtx</artifactId>
                <version>${rell.version}</version>
            </dependency>
            <dependency>
                <groupId>net.postchain.rell</groupId>
                <artifactId>rell-api-shell</artifactId>
                <version>${rell.version}</version>
            </dependency>
            <dependency>
                <groupId>net.postchain.rell</groupId>
                <artifactId>rell-api-base</artifactId>
                <version>${rell.version}</version>
            </dependency>
            <dependency>
                <groupId>net.postchain.client</groupId>
                <artifactId>postchain-client</artifactId>
                <version>${postchain.client.version}</version>
            </dependency>
            <dependency>
                <groupId>net.postchain</groupId>
                <artifactId>postchain-base</artifactId>
                <version>${postchain.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>net.postchain</groupId>
                        <artifactId>postchain-admin-service</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>io.grpc</groupId>
                        <artifactId>grpc-api</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>net.postchain</groupId>
                <artifactId>chromia-client</artifactId>
                <version>${postchain.chromia.version}</version>
            </dependency>
            <dependency>
                <groupId>net.postchain.rell</groupId>
                <artifactId>codegen-kotlin</artifactId>
                <version>${codegen.version}</version>
            </dependency>
            <dependency>
                <groupId>net.postchain.rell</groupId>
                <artifactId>codegen-mermaid</artifactId>
                <version>${codegen.version}</version>
            </dependency>
            <dependency>
                <groupId>net.postchain.rell</groupId>
                <artifactId>codegen-typescript</artifactId>
                <version>${codegen.version}</version>
            </dependency>
            <dependency>
                <groupId>net.postchain.rell</groupId>
                <artifactId>codegen-javascript</artifactId>
                <version>${codegen.version}</version>
            </dependency>
            <dependency>
                <groupId>net.postchain.rell</groupId>
                <artifactId>codegen</artifactId>
                <version>${codegen.version}</version>
            </dependency>
            <dependency> <!-- Temporarily increase jline version until upgraded in rell repo -->
                <groupId>org.jline</groupId>
                <artifactId>jline</artifactId>
                <version>3.23.0</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>${jgit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit.ssh.apache</artifactId>
                <version>${jgit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit.ssh.apache.agent</artifactId>
                <version>${jgit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-core-jvm</artifactId>
                <version>1.6.4</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
